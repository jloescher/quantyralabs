# Copy to .env.production for local reference, or set equivalent variables in Coolify (secrets UI).
# Do not commit real passwords or APP_KEY.

APP_NAME="Quantyra Labs"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://quantyralabs.cc

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=your-production-db.example.com
DB_PORT=5432
DB_DATABASE=quantyralabs
DB_USERNAME=quantyralabs
DB_PASSWORD=
# DB_SCHEMA=quantyralabs_app
# DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.quantyralabs.cc

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12

# Mail — Amazon SES (verify sending domain/address in SES; IAM: ses:SendRawEmail on resource arn:aws:ses:REGION:ACCOUNT:identity/*)
MAIL_MAILER=ses
MAIL_FROM_ADDRESS="hello@quantyralabs.cc"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# AWS_SESSION_TOKEN=

# Optional: SMTP instead of SES (set MAIL_MAILER=smtp and fill these)
# MAIL_MAILER=smtp
# MAIL_SCHEME=tls
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=

# CONTACT_NOTIFICATION_EMAIL=team@quantyralabs.cc

VITE_APP_NAME="${APP_NAME}"
