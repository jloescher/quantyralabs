APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Tunneled dev (Docker + cloudflared + Caddy): set APP_URL to your public host, e.g. https://dev.quantyralabs.cc
# VITE_DEV_SERVER_URL=https://dev.quantyralabs.cc   # optional if same as APP_URL; used for HMR + public/hot in dev
# CLOUDFLARED_TOKEN=

# Remote PostgreSQL (e.g. staging):
# - If you see "permission denied for schema public", your role cannot CREATE in public (common on PG15+ / managed Postgres).
#   Fix: (1) use a DB user that owns the database, or (2) have the host grant CREATE on schema public, or (3) create a schema
#   owned by your role and set DB_SCHEMA below (comma-separated search_path is allowed, e.g. quantyralabs_app,public).
# - Add sslmode=require in DB_URL (or DB_SSLMODE=require) if the server requires TLS.
# - Do not run migrate:fresh on shared staging; it drops all tables.

# Optional: receive plain-text copies of contact form submissions
# CONTACT_NOTIFICATION_EMAIL=team@example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Password hashing: Argon2id (see config/hashing.php). Tune with ARGON_MEMORY, ARGON_THREADS, ARGON_TIME.
HASH_DRIVER=argon2id

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL only — no Redis. Sessions, cache, and queues use this database.
# Defaults below are for local Postgres. Staging often uses a remote host, a custom port (e.g. 5000), and names like
# quantyralabs_staging / quantyralabs_staging_user — set those only in .env (never commit secrets).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=quantyralabs
DB_USERNAME=postgres
DB_PASSWORD=
# DB_SCHEMA=public
# DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
