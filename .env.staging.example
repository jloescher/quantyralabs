# Copy to .env.staging for local reference, or set equivalent variables in Coolify (secrets UI).
# Do not commit real passwords or APP_KEY.

APP_NAME="Quantyra Labs"
APP_ENV=staging
APP_KEY=
APP_DEBUG=true
APP_URL=https://staging.quantyralabs.example

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# PostgreSQL (sessions, cache, queue use this DB — no Redis)
DB_CONNECTION=pgsql
DB_HOST=your-staging-db.example.com
DB_PORT=5432
DB_DATABASE=quantyralabs_staging
DB_USERNAME=quantyralabs_staging
DB_PASSWORD=
# DB_SCHEMA=quantyralabs_app
# DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.quantyralabs.example

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12

# Mail — Amazon SES (verify sending domain/address in SES; IAM: ses:SendRawEmail on resource arn:aws:ses:REGION:ACCOUNT:identity/*)
MAIL_MAILER=ses
MAIL_FROM_ADDRESS="noreply@quantyralabs.example"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# AWS_SESSION_TOKEN=

# Optional: SMTP instead of SES (set MAIL_MAILER=smtp and fill these)
# MAIL_MAILER=smtp
# MAIL_SCHEME=tls
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=

# Optional: plain-text copies of contact submissions
# CONTACT_NOTIFICATION_EMAIL=team@quantyralabs.example

# Cloudflare Turnstile (contact form) — https://developers.cloudflare.com/turnstile/
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

VITE_APP_NAME="${APP_NAME}"

# Skip php artisan optimize on container start (faster env-only tweaks; not recommended for steady-state)
# LARAVEL_SKIP_OPTIMIZE=1
